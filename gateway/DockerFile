FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Bake in the gateway's own nginx.conf (log formats, gzip, proxy_cache, includes)
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Modular site configs (server blocks, upstreams, websockets, security, etc.)
COPY conf.d/ /etc/nginx/conf.d/

# Include-files referenced by the site configs
COPY conf.d/proxy_params /etc/nginx/proxy_params
COPY conf.d/proxy_ws /etc/nginx/proxy_ws

# TLS certificates. The repo ships empty placeholders; if they are still empty
# at runtime the entrypoint generates throwaway self-signed certs so the
# gateway starts. Replace them with real certs (e.g. volume-mount over
# /etc/nginx/certs) in production.
COPY certs/ /etc/nginx/certs/

# Create a simple index page
RUN echo '<html><body><h1>API Gateway</h1></body></html>' > /usr/share/nginx/html/index.html

# Healthcheck
HEALTHCHECK CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

COPY entrypoint.sh /docker-entrypoint.d/99-gen-certs.sh
RUN chmod +x /docker-entrypoint.d/99-gen-certs.sh

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
